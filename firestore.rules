rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserSync(data) {
      return data.keys().hasAll(['uid', 'status', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'status', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.status is string
        && data.status.size() > 0
        && data.status.size() <= 32
        && data.status in ['connected', 'active']
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    match /user_sync/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId) && isValidUserSync(incoming());
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserSync(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isOwner(userId);
    }
  }
}

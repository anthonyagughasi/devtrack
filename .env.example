# ==============================================================================
# Google Cloud SQL Database Configuration (Server-only — NEVER prefix with VITE_)
# ==============================================================================
# Option A (Recommended for Vercel Production): Official Cloud SQL Node.js Connector
# Format: <project-id>:<region>:<instance-name>
# Example: spatial-campaign-nlvvl:europe-west2:ai-studio-4e7b9940
CLOUD_SQL_CONNECTION_NAME=""
# Service Account JSON key (single-line JSON) with roles/cloudsql.client in spatial-campaign-nlvvl
GCP_SERVICE_ACCOUNT_KEY=""
# Optional Cloud SQL IP type for Connector: PUBLIC (default) | SQL_DATA | PRIVATE | PSC
CLOUD_SQL_IP_TYPE=""

# Option B (AI Studio Unix Socket OR Direct Cloud SQL Public IP + SSL)
# AI Studio socket example: /app/cloudsql/spatial-campaign-nlvvl:europe-west2:ai-studio-4e7b9940
# Direct Public IP example: <Cloud SQL Public IPv4>
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Optional Admin credentials for Drizzle Kit migrations (local/admin use only)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Cloud SQL Server CA PEM (recommended when connecting via direct TCP Public IP)
SQL_SSL_CA=""

# ==============================================================================
# Firebase Client Configuration (Public Web Config — Vercel & Local Vite)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==============================================================================
# Firebase Admin ID Token Verification (Server-only)
# ==============================================================================
FIREBASE_PROJECT_ID=""
# Optional Firebase Admin credentials (only needed for Admin IAM APIs beyond verifyIdToken)
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ==============================================================================
# Application URL
# ==============================================================================
APP_URL="MY_APP_URL"
